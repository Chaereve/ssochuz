# Cloudflare Pages headers — tăng tốc tải trang và làm mới dữ liệu đúng lúc

# File cấu hình + mã nguồn giao diện: sửa là thấy ngay, không bị dính cache
/cz-config.js
  Cache-Control: no-store, max-age=0

/cz-app.js
  Cache-Control: no-cache

/cz-home.js
  Cache-Control: no-cache

/cz-story.js
  Cache-Control: no-cache

/cz.css
  Cache-Control: no-cache

/admin.js
  Cache-Control: no-cache

/cz-auth.js
  Cache-Control: no-cache

/cz-space.js
  Cache-Control: no-cache

/cz-people.js
  Cache-Control: no-cache


# Dữ liệu: ngắn, để bản mới lên nhanh nhưng vẫn đỡ gọi mạng nhiều lần
/data/*.json
  Cache-Control: public, max-age=300

# Bảng tên chương cho ô tìm nhanh — sinh lại mỗi lần build, đổi khi thêm chương
/chuong-index.json
  Cache-Control: public, max-age=300, must-revalidate

/data/book/*
  Cache-Control: public, max-age=60

# Trang HTML luôn phải kiểm tra lại, tránh người đọc dính bản cũ
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Trang truyện: mỗi bộ có file tĩnh riêng truyen/<slug>/index.html nên URL người đọc
# KHÔNG kết thúc bằng .html — luật /*.html ở trên không với tới, phải khai riêng.
/truyen
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/truyen/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Sơ đồ web (sitemap) và robots: đổi khi thêm bộ mới
/sitemap.xml
  Cache-Control: public, max-age=600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=600

# PWA: manifest đúng MIME; sw.js không cache để bản mới có hiệu lực ngay
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=600

# Icon / ảnh thương hiệu: đổi rất hiếm, cho cache dài
/assets/*
  Cache-Control: public, max-age=86400

# ============================================================================
# AN TOÀN CHUNG — áp cho MỌI đường dẫn
#   · Content-Security-Policy: chỉ nạp mã từ chính web (+ vài nơi cần cho đăng
#     nhập: Google Identity, jsDelivr/unpkg cho supabase-js, Google Fonts).
#     Nhờ vậy kẻ chèn được chữ vào trang cũng KHÔNG chạy được mã, không đọc
#     trộm được khoá quản trị trong máy người dùng.
#   · connect-src chỉ cho các dịch vụ thật sự dùng: Worker workers.dev, Supabase,
#     Firestore cũ và Google Auth; không mở mọi https:// để giảm bề mặt gọi mạng.
#     ⚠ Riêng /sw.js có luật CSP riêng ở CUỐI TỆP (bắt buộc nằm sau khối `/*`
#     này): service worker chịu CSP của chính tệp nó, mà nó thì phải tải hộ ảnh
#     bìa ở host ngoài cho kho đọc offline.
#   · script-src-attr chặn inline event handler; frame-ancestors + X-Frame-Options
#     chống bị nhúng vào trang lạ (clickjacking).
#   · media-src 'none' — web này KHÔNG có giọng đọc audio và KHÔNG có video
#     (yêu cầu của chủ trang 20/09/2026). Chặn ở tầng header để kể cả khi có thẻ
#     <audio>/<video> lọt vào nội dung thì trình duyệt cũng không phát được.
#     Bộ lọc HTML (cleanHTML / CZ.sanitize) cũng gỡ các thẻ đó — hai lớp độc lập.
# ============================================================================
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://accounts.google.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'none'; connect-src 'self' https://*.workers.dev https://*.supabase.co https://firestore.googleapis.com https://accounts.google.com https://*.e2b.app; frame-src 'self' https://accounts.google.com https://*.supabase.co; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; worker-src 'self' blob:; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ============================================================================
# SERVICE WORKER — tệp duy nhất được phép gọi mạng ra ngoài
#   Vì sao: trình duyệt áp CSP của CHÍNH phản hồi chứa sw.js lên phạm vi worker
#   (không phải CSP của trang). Để luật `/*` áp luôn cho sw.js thì connect-src
#   ('self' + workers.dev/supabase/e2b) chặn mọi lần SW đứng ra tải hộ ảnh bìa ở
#   host ngoài (mebmarket/twimg/amazon/tmdb…) → SW trả ảnh lỗi → trang gỡ bìa:
#   lần đầu vào trang bìa còn, F5 một cái là mất sạch bìa.
#   Ở đây bỏ CSP chung cho riêng tệp này rồi đặt luật riêng: mở ĐÚNG phần mạng
#   ra ngoài (connect-src/img-src), script vẫn chỉ được nạp từ chính web. Trang
#   và mọi tệp khác giữ nguyên CSP nghiêm như cũ.
#   ⚠ LUẬT NÀY PHẢI NẰM SAU KHỐI `/*` — Cloudflare áp các luật _headers theo thứ
#   tự trong tệp (bỏ rồi đặt lại), dời lên trên là CSP chung quay lại áp cho sw.js
#   và bìa host ngoài hết được cache offline (bìa vẫn hiện nhờ sw.js tự nhường,
#   nhưng mất phần đọc offline).
# ============================================================================
/sw.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src *; img-src *; style-src 'unsafe-inline'
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache
