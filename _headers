# Cloudflare Pages headers — tăng tốc tải trang và làm mới dữ liệu đúng lúc

# File cấu hình + mã nguồn giao diện: sửa là thấy ngay, không bị dính cache
/cz-config.js
  Cache-Control: no-store, max-age=0

/cz-app.js
  Cache-Control: no-cache

/cz-home.js
  Cache-Control: no-cache

/cz-story.js
  Cache-Control: no-cache

/cz.css
  Cache-Control: no-cache

/admin.js
  Cache-Control: no-cache

/cz-auth.js
  Cache-Control: no-cache


# Dữ liệu: ngắn, để bản mới lên nhanh nhưng vẫn đỡ gọi mạng nhiều lần
/data/*.json
  Cache-Control: public, max-age=300

/data/book/*
  Cache-Control: public, max-age=60

# Trang HTML luôn phải kiểm tra lại, tránh người đọc dính bản cũ
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Trang truyện: mỗi bộ có file tĩnh riêng truyen/<slug>/index.html nên URL người đọc
# KHÔNG kết thúc bằng .html — luật /*.html ở trên không với tới, phải khai riêng.
/truyen
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/truyen/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Sơ đồ web (sitemap) và robots: đổi khi thêm bộ mới
/sitemap.xml
  Cache-Control: public, max-age=600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=600

# PWA: manifest đúng MIME; sw.js không cache để bản mới có hiệu lực ngay
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=600

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache

# Icon / ảnh thương hiệu: đổi rất hiếm, cho cache dài
/assets/*
  Cache-Control: public, max-age=86400

# ============================================================================
# AN TOÀN CHUNG — áp cho MỌI đường dẫn
#   · Content-Security-Policy: chỉ nạp mã từ chính web (+ vài nơi cần cho đăng
#     nhập: Google Identity, jsDelivr/unpkg cho supabase-js, Google Fonts).
#     Nhờ vậy kẻ chèn được chữ vào trang cũng KHÔNG chạy được mã, không đọc
#     trộm được khoá quản trị trong máy người dùng.
#   · connect-src chỉ cho các dịch vụ thật sự dùng: Worker workers.dev, Supabase,
#     Firestore cũ và Google Auth; không mở mọi https:// để giảm bề mặt gọi mạng.
#   · script-src-attr chặn inline event handler; frame-ancestors + X-Frame-Options
#     chống bị nhúng vào trang lạ (clickjacking).
# ============================================================================
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://accounts.google.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://*.workers.dev https://*.supabase.co https://firestore.googleapis.com https://accounts.google.com https://*.e2b.app; frame-src 'self' https://accounts.google.com https://*.supabase.co; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; worker-src 'self' blob:; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains
